<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Keyboard button icons for Kippix (Options > General > Look and feel > Button icons). Same keys as Playnite's own sets. -->
    <DataTemplate x:Key="ButtonPromptA">
        <Viewbox>
            <Grid Width="150" Height="64">
                <Border CornerRadius="10" BorderBrush="{DynamicResource TextBrush}" BorderThickness="5" />
                <TextBlock Text="Enter" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="30"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>
