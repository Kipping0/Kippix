<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nintendo Switch button icons for Kippix (Options > General > Look and feel > Button icons). Same keys as Playnite's own sets. -->
    <DataTemplate x:Key="ButtonPromptA">
        <Viewbox>
            <Grid Width="64" Height="64">
                <Ellipse Stroke="{DynamicResource TextBrush}" StrokeThickness="5" />
                <TextBlock Text="A" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="38"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>
